# Docker Compose only. Copy to .env.docker and use --env-file .env.docker.

# Infrastructure
# Set GRADLE_OFFLINE=1 only after the selected Buildx builder has been seeded.
MYSQL_DATABASE=phoenix
MYSQL_USER=keta
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
MYSQL_EXPOSED_PORT=3307
APP_EXPOSED_PORT=8080
METOR_IMAGE_TAG=0.1.0
METOR_PLATFORM=linux/amd64
GRADLE_OFFLINE=0
SHUTDOWN_TIMEOUT=60s

# Optional AI gateway for standalone development; AI runs on the host.
# Full-stack Compose supplies http://ai-runtime:8090 instead.
METOR_PLATFORM_AI_RUNTIME_BASE_URL=http://host.docker.internal:8090

# Platform security
METOR_PLATFORM_SECURITY_JWT_SECRET=replace-with-at-least-32-random-bytes
METOR_PLATFORM_SECURITY_ISSUER=metor-service
METOR_PLATFORM_SECURITY_ACCESS_TOKEN_TTL=20m
METOR_PLATFORM_SECURITY_REFRESH_TOKEN_TTL=14d
METOR_PLATFORM_SECURITY_MAX_LOGIN_FAILURES=5
METOR_PLATFORM_SECURITY_LOCK_DURATION=15m

# Aerospace diagnosis
METOR_AEROSPACE_DIAGNOSIS_MAX_POWER_UP_DIFF_MILLIS=40000
METOR_AEROSPACE_DIAGNOSIS_MAX_POWER_DOWN_DIFF_MILLIS=60000
METOR_AEROSPACE_DIAGNOSIS_MAX_AI_JUDGE_EVENT_NUM=15
METOR_AEROSPACE_DIAGNOSIS_INSPECTION_TYPE=1
METOR_AEROSPACE_DIAGNOSIS_ENABLED=true
METOR_AEROSPACE_DIAGNOSIS_RESULT_WRITE_BATCH_SIZE=500
METOR_AEROSPACE_DIAGNOSIS_DICTIONARY_REFRESH_INTERVAL=PT10M

# Aerospace AI Runtime
# Use http://ai-runtime:8090 when both services share a Compose network.
METOR_AEROSPACE_AI_ENABLED=false
METOR_AEROSPACE_AI_BASE_URL=http://host.docker.internal:8090
METOR_AEROSPACE_AI_CONNECT_TIMEOUT=5s
METOR_AEROSPACE_AI_READ_TIMEOUT=60s
METOR_AEROSPACE_AI_NETWORK_MAX_RETRIES=2
METOR_AEROSPACE_AI_LLM_MAX_RETRIES=2
METOR_AEROSPACE_AI_SCENES_CAUSE_JUDGE=cause-judge
METOR_AEROSPACE_AI_SCENES_CAUSE_JUDGE_REVIEW=cause-judge-review
METOR_AEROSPACE_AI_SCENES_REPORT_QUERY=report-query
METOR_AEROSPACE_AI_SCENES_INSPECTION_NODE=inspection-node
METOR_AEROSPACE_AI_SCENES_INSPECTION_SUMMARY=inspection-summary
METOR_AEROSPACE_AI_SCENES_TICKET_KEYWORD=ticket-keyword

# Aerospace decryption
# The image installs the library at /usr/local/lib/libEncryptAndDecrypt.so.
METOR_AEROSPACE_DECRYPTION_ENABLED=true

# Aerospace reports
METOR_AEROSPACE_REPORT_PDF_MAX_SIZE=100MB
