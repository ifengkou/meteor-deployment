TZ=Asia/Shanghai

# Pin release images to name@sha256:digest in production/offline delivery.
MYSQL_IMAGE=mysql:8.4
AI_RUNTIME_IMAGE=ai-runtime-service:0.1.0
METOR_IMAGE=metor-service:0.1.0
METOR_PLATFORM=linux/amd64

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
AI_DB_PASSWORD=replace-with-a-long-random-ai-password
# Password characters in this URL must be percent-encoded.
AI_DB_URL=mysql+pymysql://ai_user:replace-with-url-encoded-password@mysql:3306/metor_ai?charset=utf8mb4
METOR_DATABASE=phoenix
METOR_DB_USER=metor_user
METOR_DB_PASSWORD=replace-with-a-long-random-metor-password

AI_EMBEDDING_MODEL_HOST_PATH=/opt/icp-diag/models/embedding
AI_RUNTIME_BIND_ADDRESS=127.0.0.1
AI_RUNTIME_EXPOSED_PORT=8090
METOR_BIND_ADDRESS=127.0.0.1
APP_EXPOSED_PORT=8080

METOR_PLATFORM_SECURITY_JWT_SECRET=replace-with-at-least-32-random-bytes
METOR_AEROSPACE_AI_ENABLED=true


# Multi-model overlay: paths in embedding-models.json are container paths under /models.
AI_EMBEDDING_MODELS_HOST_PATH=/opt/icp-diag/models
AI_EMBEDDING_MODELS_CONFIG_HOST_PATH=/opt/icp-diag/config/embedding-models.json
