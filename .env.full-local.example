# Generate protected real values with scripts/local-stack.py init; never use these placeholders.
TZ=Asia/Shanghai
MYSQL_IMAGE=mysql:8.4
AI_RUNTIME_IMAGE=ai-runtime-service:p6-local
METOR_IMAGE=metor-service:p6-local
FRONTEND_IMAGE=metor-platform-frontend:p6-local
METOR_PLATFORM=linux/arm64
MYSQL_ROOT_PASSWORD=replace-root-password
AI_DB_PASSWORD=replace-ai-password
AI_DB_URL=mysql+pymysql://ai_user:replace-ai-password@mysql:3306/metor_ai?charset=utf8mb4
METOR_DATABASE=metor_service
METOR_DB_USER=metor_user
METOR_DB_PASSWORD=replace-metor-password
METOR_PLATFORM_SECURITY_JWT_SECRET=replace-with-at-least-32-random-bytes
AI_EMBEDDING_MODEL_HOST_PATH=/absolute/path/to/bge-small-zh-v1.5
AI_EMBEDDING_MODELS_CONFIG_HOST_PATH=/absolute/path/to/embedding-models.json
AI_RUNTIME_BIND_ADDRESS=127.0.0.1
AI_RUNTIME_EXPOSED_PORT=18092
METOR_BIND_ADDRESS=127.0.0.1
APP_EXPOSED_PORT=18080
FRONTEND_EXPOSED_PORT=18180
METOR_AEROSPACE_AI_ENABLED=true
